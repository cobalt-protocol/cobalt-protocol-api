// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String    @id @default(ulid())
  wallet_address String    @unique
  username       String?   @unique
  email          String?   @unique
  location       String?
  institution    String?
  created_at     DateTime  @default(now())
  updated_at     DateTime? @updatedAt
  deleted_at     DateTime?

  skill                          Skill?
  skill_description              SkillDescription?
  social_media                   SocialMedia?
  organizations                  Organization[]
  teams                          Team[]
  team_roles                     TeamRole[]
  winner                         Winner?
  nonce_connect                  NonceConnect?
  nonce_certificate_participants NonceCertificateParticipant[]
  nonce_certificate_winners      NonceCertificateWinner[]

  @@map("users")
}

model Skill {
  id         String    @id @default(ulid())
  user_id    String    @unique
  skill_name String    @unique
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  deleted_at DateTime?

  user User @relation(fields: [user_id], references: [id])

  @@map("skills")
}

model SkillDescription {
  id          String    @id @default(ulid())
  description String
  user_id     String    @unique
  created_at  DateTime  @default(now())
  updated_at  DateTime? @updatedAt
  deleted_at  Int?

  user User @relation(fields: [user_id], references: [id])

  @@map("skill_description")
}

model SocialMedia {
  id            String    @id @default(ulid())
  github_link   String
  linkedin_link String
  user_id       String    @unique
  created_at    DateTime  @default(now())
  updated_at    DateTime? @updatedAt
  deleted_at    Int?

  user User @relation(fields: [user_id], references: [id])

  @@map("social_media")
}

model Organization {
  id          String    @id @default(ulid())
  tx_hash     String    @unique
  avatar_url  String?   @unique
  name        String?   @unique
  description String?   @unique
  user_id     String
  created_at  DateTime  @default(now())
  updated_at  DateTime? @updatedAt
  deleted_at  DateTime?

  user User @relation(fields: [user_id], references: [id])

  @@map("organization")
}

model Competition {
  id                      String    @id @default(ulid())
  tx_hash                 String    @unique
  name                    String
  category                String
  description             String
  requirement             String
  registration_window     DateTime
  competition_window      DateTime
  submission_deadline     DateTime
  judging_review          DateTime
  result_announcement     DateTime
  pirze_certificate_claim DateTime
  certificate_cid         String
  guidebook_cid           String
  created_at              DateTime  @default(now())
  updated_at              DateTime? @updatedAt
  deleted_at              DateTime?

  prize_winners                  PrizeWinner[]
  teams                          Team[]
  nonce_certificate_participants NonceCertificateParticipant[]
  nonce_certificate_winners      NonceCertificateWinner[]

  @@map("competition")
}

model PrizeWinner {
  id              String    @id @default(ulid())
  category        String
  amount          Int
  certificate_cid String
  competition_id  String
  created_at      DateTime  @default(now())
  updated_at      DateTime? @updatedAt
  deleted_at      DateTime?

  competition Competition @relation(fields: [competition_id], references: [id])
  winner      Winner?

  @@map("prize_winner")
}

model Team {
  id             String    @id @default(ulid())
  name           String
  visibility     Boolean
  description    String
  competition_id String
  user_id        String
  created_at     DateTime  @default(now())
  updated_at     DateTime? @updatedAt
  deleted_at     DateTime?

  competition        Competition        @relation(fields: [competition_id], references: [id])
  user               User               @relation(fields: [user_id], references: [id])
  skills_suggestions SkillsSuggestion[]
  team_codes         TeamCode[]
  team_roles         TeamRole[]

  @@map("team")
}

model SkillsSuggestion {
  id         String    @id @default(ulid())
  name       String
  team_id    String
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  deleted_at DateTime?

  team Team @relation(fields: [team_id], references: [id])

  @@map("skills_suggestion")
}

model TeamCode {
  id         String    @id @default(ulid())
  code       String
  team_id    String?
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  deleted_at DateTime?

  team Team? @relation(fields: [team_id], references: [id])

  @@map("team_code")
}

model TeamRole {
  id         String    @id @default(ulid())
  role       String
  user_id    String
  team_id    String
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  deleted_at DateTime?

  user User @relation(fields: [user_id], references: [id])
  team Team @relation(fields: [team_id], references: [id])

  @@map("team_role")
}

model Winner {
  id              String    @id @default(ulid())
  wallet_address  String
  user_id         String    @unique
  prize_winner_id String    @unique
  created_at      DateTime  @default(now())
  updated_at      DateTime? @updatedAt
  deleted_at      DateTime?

  user         User        @relation(fields: [user_id], references: [id])
  prize_winner PrizeWinner @relation(fields: [prize_winner_id], references: [id])

  @@map("winner")
}

model NonceConnect {
  id         String    @id @default(ulid())
  nonce      String    @unique
  user_id    String    @unique
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  deleted_at DateTime?

  user User @relation(fields: [user_id], references: [id])

  @@map("nonce_connect")
}

model NonceCertificateParticipant {
  id             String    @id @default(ulid())
  nonce          String    @unique
  user_id        String
  competition_id String
  created_at     DateTime  @default(now())
  updated_at     DateTime? @updatedAt
  deleted_at     DateTime?

  user        User        @relation(fields: [user_id], references: [id])
  competition Competition @relation(fields: [competition_id], references: [id])

  @@map("nonce_certificate_participant")
}

model NonceCertificateWinner {
  id             String    @id @default(ulid())
  nonce          String    @unique
  user_id        String
  competition_id String
  created_at     DateTime  @default(now())
  updated_at     DateTime? @updatedAt
  deleted_at     DateTime?

  user        User        @relation(fields: [user_id], references: [id])
  competition Competition @relation(fields: [competition_id], references: [id])

  @@map("nonce_certificate_winner")
}
