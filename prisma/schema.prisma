generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                                     String                               @id @default(ulid()) @db.VarChar
  wallet_address                         String                               @unique @db.VarChar
  username                               String?                              @unique @db.VarChar
  email                                  String?                              @unique @db.VarChar
  location                               String?                              @db.VarChar
  institution                            String?                              @db.VarChar
  created_at                             DateTime                             @default(now()) @db.Timestamptz(6)
  updated_at                             DateTime?                            @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at                             DateTime?                            @db.Timestamptz(6)
  certificate_participant_minteds        CertificateParticipantMinted[]
  certificate_participant_winner_minteds CertificateParticipantWinnerMinted[]
  competitions                           Competition[]
  nonce_connect                          NonceConnect?
  organizations                          Organization[]
  request_joins                          RequestJoin[]
  signature_certificate_participants     SignatureCertificateParticipant[]
  signature_certificate_winners          SignatureCertificateWinner[]
  skill_description                      SkillDescriptionUser?
  skills                                 SkillUser[]
  social_media                           SocialMediaUser?
  teams                                  Team[]
  team_roles                             TeamRole[]
  winner                                 Winner?

  @@map("users")
}

model SkillUser {
  id         String    @id @default(ulid()) @db.VarChar
  user_id    String    @db.VarChar
  skill_name String    @db.VarChar
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at DateTime? @db.Timestamptz(6)
  user       User      @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([user_id, skill_name])
  @@map("skills_user")
}

model SkillDescriptionUser {
  id          String    @id @default(ulid()) @db.VarChar
  description String    @db.VarChar
  user_id     String    @unique @db.VarChar
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime? @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at  DateTime? @db.Timestamptz(6)
  user        User      @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("skill_description_user")
}

model SocialMediaUser {
  id            String    @id @default(ulid()) @db.VarChar
  github_link   String    @db.VarChar
  linkedin_link String    @db.VarChar
  user_id       String    @unique @db.VarChar
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime? @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at    DateTime? @db.Timestamptz(6)
  user          User      @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("social_media_user")
}

model Organization {
  id          String    @id @default(ulid()) @db.VarChar
  tx_hash     String    @unique @db.VarChar
  avatar_url  String?   @unique @db.VarChar
  name        String?   @unique @db.VarChar
  description String?   @unique @db.VarChar
  user_id     String    @db.VarChar
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime? @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at  DateTime? @db.Timestamptz(6)
  user        User      @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("organization")
}

model Competition {
  id                                    String                               @id @default(ulid()) @db.VarChar
  tx_hash                               String                               @unique @db.VarChar
  name                                  String                               @db.VarChar
  category                              String                               @db.VarChar
  description                           String                               @db.VarChar
  requirement                           String                               @db.VarChar
  formation                             String                               @db.VarChar
  registration_window                   DateTime                             @db.Timestamptz(6)
  competition_window                    DateTime                             @db.Timestamptz(6)
  submission_deadline                   DateTime                             @db.Timestamptz(6)
  judging_review                        DateTime                             @db.Timestamptz(6)
  result_announcement                   DateTime                             @db.Timestamptz(6)
  pirze_certificate_claim               DateTime                             @db.Timestamptz(6)
  certificate_cid                       String                               @db.VarChar
  guidebook_cid                         String                               @db.VarChar
  fee                                   Decimal?                             @db.Decimal(78, 0)
  fee_token_address                     String?                              @db.VarChar
  user_id                               String?                              @db.VarChar
  price_competition_id                  String?                              @db.VarChar
  competition_id                        String                               @db.VarChar
  indexer_state_id                      String?                              @db.VarChar
  created_at                            DateTime                             @default(now()) @db.Timestamptz(6)
  updated_at                            DateTime?                            @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at                            DateTime?                            @db.Timestamptz(6)
  certificate_participant_minted        CertificateParticipantMinted[]
  certificate_participant_winner_minted CertificateParticipantWinnerMinted[]
  indexer_state                         IndexerState?                        @relation(fields: [indexer_state_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  price_competition                     PriceCompetition?                    @relation(fields: [price_competition_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user                                  User?                                @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  competition_fee_paid                  CompetitionFeePaid?
  participant_winners                   ParticipantWinner[]
  prize_deposits                        PrizeDeposited[]
  prize_distributions                   PrizeDistributed[]
  prize_winners                         PrizeWinner[]
  signature_certificate_participants    SignatureCertificateParticipant[]
  signature_certificate_winners         SignatureCertificateWinner[]
  signature_set_winners                 SignatureSetWinner[]
  teams                                 Team[]

  @@map("competition")
}

model PrizeWinner {
  id              String      @id @default(ulid()) @db.VarChar
  winner_id       BigInt
  category        String      @db.VarChar
  amount          Decimal     @db.Decimal(78, 0)
  certificate_cid String      @db.VarChar
  competition_id  String      @db.VarChar
  created_at      DateTime    @default(now()) @db.Timestamptz(6)
  updated_at      DateTime?   @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at      DateTime?   @db.Timestamptz(6)
  competition     Competition @relation(fields: [competition_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  winner          Winner?

  @@map("prize_winner")
}

model Team {
  id                                     String                               @id @default(ulid()) @db.VarChar
  name                                   String                               @db.VarChar
  visibility                             Boolean
  description                            String                               @db.VarChar
  competition_id                         String                               @db.VarChar
  user_id                                String                               @db.VarChar
  created_at                             DateTime                             @default(now()) @db.Timestamptz(6)
  updated_at                             DateTime?                            @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at                             DateTime?                            @db.Timestamptz(6)
  certificate_participant_minteds        CertificateParticipantMinted[]
  certificate_participant_winner_minteds CertificateParticipantWinnerMinted[]
  request_joins                          RequestJoin[]
  requirements_team                      RequirementsTeam?
  signature_certificate_participants     SignatureCertificateParticipant[]
  signature_certificate_winners          SignatureCertificateWinner[]
  signature_set_winner                   SignatureSetWinner?
  skills_team                            SkillsTeam[]
  submission_project                     SubmissionProject?
  competition                            Competition                          @relation(fields: [competition_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user                                   User                                 @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  team_codes                             TeamCode[]
  team_roles                             TeamRole[]

  @@map("team")
}

model SkillsTeam {
  id         String    @id @default(ulid()) @db.VarChar
  name       String    @db.VarChar
  team_id    String    @db.VarChar
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at DateTime? @db.Timestamptz(6)
  team       Team      @relation(fields: [team_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("skills_team")
}

model RequirementsTeam {
  id          String    @id @default(ulid()) @db.VarChar
  requirement String    @db.VarChar
  team_id     String    @unique @db.VarChar
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime? @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at  DateTime? @db.Timestamptz(6)
  team        Team      @relation(fields: [team_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("requirements_team")
}

model RequestJoin {
  id         String    @id @default(ulid()) @db.VarChar
  status     String    @db.VarChar
  user_id    String    @db.VarChar
  team_id    String    @db.VarChar
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at DateTime? @db.Timestamptz(6)
  team       Team      @relation(fields: [team_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user       User      @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("request_join")
}

model TeamCode {
  id         String    @id @default(ulid()) @db.VarChar
  code       String    @db.VarChar
  team_id    String?   @db.VarChar
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at DateTime? @db.Timestamptz(6)
  team       Team?     @relation(fields: [team_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("team_code")
}

model TeamRole {
  id         String    @id @default(ulid()) @db.VarChar
  role       String    @db.VarChar
  user_id    String    @db.VarChar
  team_id    String    @db.VarChar
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at DateTime? @db.Timestamptz(6)
  team       Team      @relation(fields: [team_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user       User      @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("team_role")
}

model SubmissionProject {
  id              String    @id @default(ulid()) @db.VarChar
  title           String    @db.VarChar
  description     String?   @db.VarChar
  submission_link String    @db.VarChar
  document_cid    String    @db.VarChar
  team_id         String    @unique @db.VarChar
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime? @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at      DateTime? @db.Timestamptz(6)
  team            Team      @relation(fields: [team_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("submission_project")
}

model Winner {
  id              String      @id @default(ulid()) @db.VarChar
  wallet_address  String      @db.VarChar
  user_id         String      @unique @db.VarChar
  prize_winner_id String      @unique @db.VarChar
  created_at      DateTime    @default(now()) @db.Timestamptz(6)
  updated_at      DateTime?   @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at      DateTime?   @db.Timestamptz(6)
  prize_winner    PrizeWinner @relation(fields: [prize_winner_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user            User        @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("winner")
}

model NonceConnect {
  id         String    @id @default(ulid()) @db.VarChar
  nonce      String    @unique @db.VarChar
  user_id    String    @unique @db.VarChar
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at DateTime? @db.Timestamptz(6)
  user       User      @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("nonce_connect")
}

model SignatureCertificateParticipant {
  id               String        @id @default(ulid()) @db.VarChar
  signature        String        @db.VarChar
  user_id          String        @db.VarChar
  competition_id   String        @db.VarChar
  team_id          String        @db.VarChar
  indexer_state_id String?       @db.VarChar
  created_at       DateTime      @default(now()) @db.Timestamptz(6)
  updated_at       DateTime?     @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at       DateTime?     @db.Timestamptz(6)
  competition      Competition   @relation(fields: [competition_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  indexer_state    IndexerState? @relation(fields: [indexer_state_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  team             Team          @relation(fields: [team_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user             User          @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("signature_certificate_participant")
}

model SignatureCertificateWinner {
  id               String        @id @default(ulid()) @db.VarChar
  signature        String        @db.VarChar
  user_id          String        @db.VarChar
  competition_id   String        @db.VarChar
  team_id          String        @db.VarChar
  indexer_state_id String?       @db.VarChar
  created_at       DateTime      @default(now()) @db.Timestamptz(6)
  updated_at       DateTime?     @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at       DateTime?     @db.Timestamptz(6)
  competition      Competition   @relation(fields: [competition_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  indexer_state    IndexerState? @relation(fields: [indexer_state_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  team             Team          @relation(fields: [team_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user             User          @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("signature_certificate_winner")
}

model SignatureSetWinner {
  id               String        @id @default(ulid()) @db.VarChar
  signature        String        @db.VarChar
  competition_id   String        @db.VarChar
  team_id          String        @unique @db.VarChar
  indexer_state_id String?       @db.VarChar
  created_at       DateTime      @default(now()) @db.Timestamptz(6)
  updated_at       DateTime?     @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at       DateTime?     @db.Timestamptz(6)
  competition      Competition   @relation(fields: [competition_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  indexer_state    IndexerState? @relation(fields: [indexer_state_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  team             Team          @relation(fields: [team_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("signature_set_winner")
}

model ListingToken {
  id               String        @id @default(ulid()) @db.VarChar
  tx_hash          String        @db.VarChar
  listing_token_id BigInt
  token_address    String        @db.VarChar
  is_active        Boolean
  indexer_state_id String?       @db.VarChar
  created_at       DateTime      @default(now()) @db.Timestamptz(6)
  updated_at       DateTime?     @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at       DateTime?     @db.Timestamptz(6)
  indexer_state    IndexerState? @relation(fields: [indexer_state_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("listing_token")
}

model PrizeDeposited {
  id                String        @id @default(ulid()) @db.VarChar
  tx_hash           String        @db.VarChar
  treasury_prize_id BigInt
  competition_id    String        @db.VarChar
  token_address     String        @db.VarChar
  sender            String        @db.VarChar
  amount            Decimal       @db.Decimal(78, 0)
  indexer_state_id  String?       @db.VarChar
  created_at        DateTime      @default(now()) @db.Timestamptz(6)
  updated_at        DateTime?     @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at        DateTime?     @db.Timestamptz(6)
  competition       Competition   @relation(fields: [competition_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  indexer_state     IndexerState? @relation(fields: [indexer_state_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("prize_deposited")
}

model PriceCompetition {
  id                       String        @id @default(ulid()) @db.VarChar
  tx_hash                  String        @db.VarChar
  price_competition_fee_id BigInt        @unique
  treasury_fee             Decimal       @db.Decimal(78, 0)
  token_address            String        @db.VarChar
  title                    String        @db.VarChar
  description              String        @db.VarChar
  indexer_state_id         String?       @db.VarChar
  created_at               DateTime      @default(now()) @db.Timestamptz(6)
  updated_at               DateTime?     @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at               DateTime?     @db.Timestamptz(6)
  competitions             Competition[]
  indexer_state            IndexerState? @relation(fields: [indexer_state_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("price_competition")
}

model CompetitionFeePaid {
  id               String        @id @default(ulid()) @db.VarChar
  tx_hash          String        @db.VarChar
  competition_id   String        @unique @db.VarChar
  payer            String        @db.VarChar
  token_address    String        @db.VarChar
  amount           Decimal       @db.Decimal(78, 0)
  indexer_state_id String?       @db.VarChar
  created_at       DateTime      @default(now()) @db.Timestamptz(6)
  updated_at       DateTime?     @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at       DateTime?     @db.Timestamptz(6)
  competition      Competition   @relation(fields: [competition_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  indexer_state    IndexerState? @relation(fields: [indexer_state_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("competition_fee_paid")
}

model ParticipantWinner {
  id                    String        @id @default(ulid()) @db.VarChar
  tx_hash               String        @db.VarChar
  winner_id             BigInt
  participant           String        @db.VarChar
  participant_winner_id BigInt
  title                 String        @db.VarChar
  competition_id        String        @db.VarChar
  indexer_state_id      String?       @db.VarChar
  created_at            DateTime      @default(now()) @db.Timestamptz(6)
  updated_at            DateTime?     @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at            DateTime?     @db.Timestamptz(6)
  competition           Competition   @relation(fields: [competition_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  indexer_state         IndexerState? @relation(fields: [indexer_state_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("participant_winner")
}

model PrizeDistributed {
  id                String        @id @default(ulid()) @db.VarChar
  tx_hash           String        @db.VarChar
  treasury_prize_id BigInt
  competition_id    String        @db.VarChar
  token_address     String        @db.VarChar
  recipient         String        @db.VarChar
  amount            Decimal       @db.Decimal(78, 0)
  indexer_state_id  String?       @db.VarChar
  created_at        DateTime      @default(now()) @db.Timestamptz(6)
  updated_at        DateTime?     @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at        DateTime?     @db.Timestamptz(6)
  competition       Competition   @relation(fields: [competition_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  indexer_state     IndexerState? @relation(fields: [indexer_state_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("prize_distributed")
}

model CertificateParticipantMinted {
  id               String        @id @default(ulid()) @db.VarChar
  tx_hash          String        @db.VarChar
  token_id         BigInt
  competition_id   String        @db.VarChar
  team_id          String?       @db.VarChar
  uri              String        @db.VarChar
  user_id          String?       @db.VarChar
  indexer_state_id String?       @db.VarChar
  created_at       DateTime      @default(now()) @db.Timestamptz(6)
  updated_at       DateTime?     @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at       DateTime?     @db.Timestamptz(6)
  competition      Competition   @relation(fields: [competition_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  indexer_state    IndexerState? @relation(fields: [indexer_state_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  team             Team?         @relation(fields: [team_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user             User?         @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([team_id], map: "ix_certificate_participant_minted_team_id")
  @@index([user_id], map: "ix_certificate_participant_minted_user_id")
  @@map("certificate_participant_minted")
}

model CertificateParticipantWinnerMinted {
  id               String        @id @default(ulid()) @db.VarChar
  tx_hash          String        @db.VarChar
  token_id         BigInt
  competition_id   String        @db.VarChar
  team_id          String?       @db.VarChar
  winner_id        BigInt
  uri              String        @db.VarChar
  user_id          String?       @db.VarChar
  indexer_state_id String?       @db.VarChar
  created_at       DateTime      @default(now()) @db.Timestamptz(6)
  updated_at       DateTime?     @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at       DateTime?     @db.Timestamptz(6)
  competition      Competition   @relation(fields: [competition_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  indexer_state    IndexerState? @relation(fields: [indexer_state_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  team             Team?         @relation(fields: [team_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user             User?         @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([team_id], map: "ix_certificate_participant_winner_minted_team_id")
  @@index([user_id], map: "ix_certificate_participant_winner_minted_user_id")
  @@map("certificate_participant_winner_minted")
}

model IndexerState {
  id                                     String                               @id @default(ulid()) @db.VarChar
  contract_name                          String                               @db.VarChar
  chain_id                               Int
  last_scanned_block                     Int
  created_at                             DateTime                             @default(now()) @db.Timestamptz(6)
  updated_at                             DateTime?                            @default(now()) @updatedAt @db.Timestamptz(6)
  certificate_participant_minteds        CertificateParticipantMinted[]
  certificate_participant_winner_minteds CertificateParticipantWinnerMinted[]
  competitions                           Competition[]
  competition_fee_paids                  CompetitionFeePaid[]
  listing_tokens                         ListingToken[]
  participant_winners                    ParticipantWinner[]
  price_competitions                     PriceCompetition[]
  prize_deposits                         PrizeDeposited[]
  prize_distributions                    PrizeDistributed[]
  signature_certificate_participants     SignatureCertificateParticipant[]
  signature_certificate_winners          SignatureCertificateWinner[]
  signature_set_winners                  SignatureSetWinner[]

  @@unique([contract_name, chain_id])
  @@index([contract_name], map: "ix_indexer_state_contract_name")
  @@map("indexer_state")
}

enum CompetitionPublicationStatus {
  DRAFT
  PUBLISHED
}

