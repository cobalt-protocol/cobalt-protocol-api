// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String    @id @default(uuid())
  wallet_address String    @unique
  username       String?   @unique
  email          String?   @unique
  location       String?
  institution    String?
  created_at     DateTime  @default(now())
  updated_at     DateTime? @updatedAt
  deleted_at     DateTime?

  skills            Skill[]
  auth_sessions     AuthSession[]
  skill_description SkillDescription?
  social_media      SocialMedia?
  organizations     Organization[]
  teams             Team[]
  team_roles        TeamRole[]

  @@map("users")
}

model Skill {
  id         String    @id @default(uuid())
  user_id    String
  skill_name String
  level      SkillLevel @default(INTERMEDIATE)
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  deleted_at DateTime?

  user User @relation(fields: [user_id], references: [id])

  @@unique([user_id, skill_name])
  @@map("skills")
}

enum SkillLevel {
  INTERMEDIATE
  PROFICIENT
  ADVANCED
  EXPERT
}

model AuthSession {
  id         String    @id @default(uuid())
  user_id    String
  token_hash String    @unique
  expires_at DateTime
  revoked_at DateTime?
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("auth_sessions")
}

model SkillDescription {
  id          String    @id @default(uuid())
  description String
  user_id     String    @unique
  created_at  DateTime  @default(now())
  updated_at  DateTime? @updatedAt
  deleted_at  Int?

  user User @relation(fields: [user_id], references: [id])

  @@map("skill_description")
}

model SocialMedia {
  id            String    @id @default(uuid())
  github_link   String
  linkedin_link String
  user_id       String    @unique
  created_at    DateTime  @default(now())
  updated_at    DateTime? @updatedAt
  deleted_at    Int?

  user User @relation(fields: [user_id], references: [id])

  @@map("social_media")
}

model Organization {
  id          String    @id @default(uuid())
  avatar_url  String    @unique
  name        String    @unique
  description String    @unique
  user_id     String
  created_at  DateTime  @default(now())
  updated_at  DateTime? @updatedAt
  deleted_at  DateTime?

  user User @relation(fields: [user_id], references: [id])

  @@map("organization")
}

model Competition {
  id                      String    @id @default(uuid())
  name                    String
  category                String
  description             String
  requirement             String
  registration_window     DateTime
  competition_window      DateTime
  submission_deadline     DateTime
  judging_review          DateTime
  result_announcement     DateTime
  pirze_certificate_claim DateTime
  certificate_cid         String
  guidebook_cid           String
  created_at              DateTime  @default(now())
  updated_at              DateTime? @updatedAt
  deleted_at              DateTime?

  prize_winners PrizeWinner[]
  teams         Team[]

  @@map("competition")
}

model PrizeWinner {
  id              String    @id @default(uuid())
  category        String
  amount          Int
  certificate_cid String
  competition_id  String
  created_at      DateTime  @default(now())
  updated_at      DateTime? @updatedAt
  deleted_at      DateTime?

  competition Competition @relation(fields: [competition_id], references: [id])

  @@map("prize_winner")
}

model Team {
  id             String    @id @default(uuid())
  name           String
  visibility     Boolean
  description    String
  competition_id String
  user_id        String
  created_at     DateTime  @default(now())
  updated_at     DateTime? @updatedAt
  deleted_at     DateTime?

  competition        Competition        @relation(fields: [competition_id], references: [id])
  user               User               @relation(fields: [user_id], references: [id])
  skills_suggestions SkillsSuggestion[]
  team_codes         TeamCode[]
  team_roles         TeamRole[]

  @@map("team")
}

model SkillsSuggestion {
  id         String    @id @default(uuid())
  name       String
  team_id    String
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  deleted_at DateTime?

  team Team @relation(fields: [team_id], references: [id])

  @@map("skills_suggestion")
}

model TeamCode {
  id         String    @id @default(uuid())
  code       String
  team_id    String?
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  deleted_at DateTime?

  team Team? @relation(fields: [team_id], references: [id])

  @@map("team_code")
}

model TeamRole {
  id         String    @id @default(uuid())
  role       String
  user_id    String
  team_id    String
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  deleted_at DateTime?

  user User @relation(fields: [user_id], references: [id])
  team Team @relation(fields: [team_id], references: [id])

  @@map("team_role")
}

model Winner {
  id             String    @id @default(uuid())
  wallet_address String
  created_at     DateTime  @default(now())
  updated_at     DateTime? @updatedAt
  deleted_at     DateTime?

  @@map("winner")
}
