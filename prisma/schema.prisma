// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String    @id @default(ulid())
  wallet_address String    @unique
  username       String?   @unique
  email          String?   @unique
  location       String?
  institution    String?
  created_at     DateTime  @default(now())
  updated_at     DateTime? @updatedAt
  deleted_at     DateTime?

  skill                          Skill?
  skill_description              SkillDescription?
  social_media                   SocialMedia?
  organizations                  Organization[]
  teams                          Team[]
  team_roles                     TeamRole[]
  winner                         Winner?
  nonce_connect                  NonceConnect?
  nonce_certificate_participants NonceCertificateParticipant[]
  nonce_certificate_winners      NonceCertificateWinner[]
  competitions                   Competition[]

  @@map("users")
}

model Skill {
  id         String    @id @default(ulid())
  user_id    String    @unique
  skill_name String    @unique
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  deleted_at DateTime?

  user User @relation(fields: [user_id], references: [id])

  @@unique([user_id, skill_name])
  @@map("skills")
}

enum SkillLevel {
  INTERMEDIATE
  PROFICIENT
  ADVANCED
  EXPERT
}

model AuthSession {
  id         String    @id @default(uuid())
  user_id    String
  token_hash String    @unique
  expires_at DateTime
  revoked_at DateTime?
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("auth_sessions")
}

model SkillDescription {
  id          String    @id @default(ulid())
  description String
  user_id     String    @unique
  created_at  DateTime  @default(now())
  updated_at  DateTime? @updatedAt
  deleted_at  DateTime?

  user User @relation(fields: [user_id], references: [id])

  @@map("skill_description")
}

model SocialMedia {
  id            String    @id @default(ulid())
  github_link   String
  linkedin_link String
  user_id       String    @unique
  created_at    DateTime  @default(now())
  updated_at    DateTime? @updatedAt
  deleted_at    DateTime?

  user User @relation(fields: [user_id], references: [id])

  @@map("social_media")
}

model Organization {
  id          String    @id @default(ulid())
  tx_hash     String    @unique
  avatar_url  String?   @unique
  name        String?   @unique
  description String?   @unique
  user_id     String
  created_at  DateTime  @default(now())
  updated_at  DateTime? @updatedAt
  deleted_at  DateTime?

  user User @relation(fields: [user_id], references: [id])

  @@map("organization")
}

model Competition {
  id                      String    @id @default(ulid())
  tx_hash                 String    @unique
  name                    String
  category                String
  description             String
  requirement             String
  registration_window     DateTime
  competition_window      DateTime
  submission_deadline     DateTime
  judging_review          DateTime
  result_announcement     DateTime
  pirze_certificate_claim DateTime
  certificate_cid         String
  guidebook_cid           String
  token_address           String
  user_id                 String?
  price_competition_id    String?
  competition_id          String
  created_at              DateTime  @default(now())
  updated_at              DateTime? @updatedAt
  deleted_at              DateTime?

  user                           User?                         @relation(fields: [user_id], references: [id])
  price_competition              PriceCompetition?             @relation(fields: [price_competition_id], references: [id])
  prize_winners                  PrizeWinner[]
  teams                          Team[]
  nonce_certificate_participants NonceCertificateParticipant[]
  nonce_certificate_winners      NonceCertificateWinner[]
  prize_deposits                 PrizeDeposited[]
  competition_fee_paid           CompetitionFeePaid?
  participant_winners            ParticipantWinner[]
  prize_distributions            PrizeDistributed[]

  @@map("competition")
}

model PrizeWinner {
  id              String    @id @default(ulid())
  winner_id       BigInt
  category        String
  amount          Decimal
  certificate_cid String
  competition_id  String
  created_at      DateTime  @default(now())
  updated_at      DateTime? @updatedAt
  deleted_at      DateTime?

  competition Competition @relation(fields: [competition_id], references: [id])
  winner      Winner?

  @@map("prize_winner")
}

model Team {
  id             String    @id @default(ulid())
  name           String
  visibility     Boolean
  description    String
  competition_id String
  user_id        String
  created_at     DateTime  @default(now())
  updated_at     DateTime? @updatedAt
  deleted_at     DateTime?

  competition        Competition        @relation(fields: [competition_id], references: [id])
  user               User               @relation(fields: [user_id], references: [id])
  skills_suggestions SkillsSuggestion[]
  team_codes         TeamCode[]
  team_roles         TeamRole[]
  join_requests      TeamJoinRequest[]

  @@map("team")
}

model SkillsSuggestion {
  id         String    @id @default(ulid())
  name       String
  team_id    String
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  deleted_at DateTime?

  team Team @relation(fields: [team_id], references: [id])

  @@map("skills_suggestion")
}

model TeamCode {
  id         String    @id @default(ulid())
  code       String
  team_id    String?
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  deleted_at DateTime?

  team Team? @relation(fields: [team_id], references: [id])

  @@map("team_code")
}

model TeamRole {
  id         String    @id @default(ulid())
  role       String
  user_id    String
  team_id    String
  competition_id String
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  deleted_at DateTime?

  user User @relation(fields: [user_id], references: [id])
  team Team @relation(fields: [team_id], references: [id])
  competition Competition @relation(fields: [competition_id], references: [id])

  @@unique([user_id, competition_id])
  @@unique([user_id, team_id])

  @@map("team_role")
}

model TeamJoinRequest {
  id             String   @id @default(uuid())
  user_id        String
  team_id        String
  competition_id String
  status         String   @default("PENDING")
  created_at     DateTime @default(now())
  updated_at     DateTime? @updatedAt

  user User @relation(fields: [user_id], references: [id])
  team Team @relation(fields: [team_id], references: [id])
  competition Competition @relation(fields: [competition_id], references: [id])

  @@unique([competition_id, user_id])
  @@index([team_id, status])
  @@map("team_join_requests")
}

model Winner {
  id              String    @id @default(ulid())
  wallet_address  String
  user_id         String    @unique
  prize_winner_id String    @unique
  created_at      DateTime  @default(now())
  updated_at      DateTime? @updatedAt
  deleted_at      DateTime?

  user         User        @relation(fields: [user_id], references: [id])
  prize_winner PrizeWinner @relation(fields: [prize_winner_id], references: [id])

  @@map("winner")
}

model NonceConnect {
  id         String    @id @default(ulid())
  nonce      String    @unique
  user_id    String    @unique
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  deleted_at DateTime?

  user User @relation(fields: [user_id], references: [id])

  @@map("nonce_connect")
}

model NonceCertificateParticipant {
  id             String    @id @default(ulid())
  nonce          String    @unique
  user_id        String
  competition_id String
  created_at     DateTime  @default(now())
  updated_at     DateTime? @updatedAt
  deleted_at     DateTime?

  user        User        @relation(fields: [user_id], references: [id])
  competition Competition @relation(fields: [competition_id], references: [id])

  @@map("nonce_certificate_participant")
}

model NonceCertificateWinner {
  id             String    @id @default(ulid())
  nonce          String    @unique
  user_id        String
  competition_id String
  created_at     DateTime  @default(now())
  updated_at     DateTime? @updatedAt
  deleted_at     DateTime?

  user        User        @relation(fields: [user_id], references: [id])
  competition Competition @relation(fields: [competition_id], references: [id])

  @@map("nonce_certificate_winner")
}

model ListingTokenPrize {
  id                     String    @id @default(ulid())
  tx_hash                String
  listing_token_prize_id BigInt
  token_address          String
  is_active              Boolean   @default(true)
  created_at             DateTime  @default(now())
  updated_at             DateTime? @updatedAt
  deleted_at             DateTime?

  @@map("listing_token_prize")
}

model PrizeDeposited {
  id                String    @id @default(ulid())
  tx_hash           String
  treasury_prize_id BigInt
  competition_id    String
  token_address     String
  sender            String
  amount            Decimal
  created_at        DateTime  @default(now())
  updated_at        DateTime? @updatedAt
  deleted_at        DateTime?

  competition Competition @relation(fields: [competition_id], references: [id])

  @@map("prize_deposited")
}

model PriceCompetition {
  id                       String    @id @default(ulid())
  tx_hash                  String
  price_competition_fee_id BigInt    @unique
  treasury_fee             Decimal
  token_address            String
  title                    String
  description              String
  created_at               DateTime  @default(now())
  updated_at               DateTime? @updatedAt
  deleted_at               DateTime?

  competitions Competition[]

  @@map("price_competition")
}

model CompetitionFeePaid {
  id             String    @id @default(ulid())
  tx_hash        String
  competition_id String    @unique
  payer          String
  token_address  String
  amount         Decimal
  created_at     DateTime  @default(now())
  updated_at     DateTime? @updatedAt
  deleted_at     DateTime?

  competition Competition @relation(fields: [competition_id], references: [id])

  @@map("competition_fee_paid")
}

model ParticipantWinner {
  id                    String    @id @default(ulid())
  tx_hash               String
  winner_id             BigInt
  participant           String
  participant_winner_id BigInt
  title                 String
  competition_id        String
  created_at            DateTime  @default(now())
  updated_at            DateTime? @updatedAt
  deleted_at            DateTime?

  competition Competition @relation(fields: [competition_id], references: [id])

  @@map("participant_winner")
}

model PrizeDistributed {
  id                String    @id @default(ulid())
  tx_hash           String
  treasury_prize_id BigInt
  competition_id    String
  token_address     String
  recipient         String
  amount            Decimal
  created_at        DateTime  @default(now())
  updated_at        DateTime? @updatedAt
  deleted_at        DateTime?

  competition Competition @relation(fields: [competition_id], references: [id])

  @@map("prize_distributed")
}
